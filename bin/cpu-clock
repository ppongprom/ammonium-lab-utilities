#!/usr/bin/env bash
# วัดความเร็ว CPU ของทุก node ในคลัสเตอร์ Proxmox (pve01-06) — ทั้ง clock speed ที่ตั้งไว้
# (จาก lscpu) และ compute throughput จริง (จาก openssl speed) เพราะ clock MHz เพียงอย่างเดียว
# ไม่บอกว่าเครื่องไหนช้าจริงเวลามีงานพร้อมกันหลายตัว (turbo/thermal throttle ต่างกันได้)
#
# ไม่ hardcode รายชื่อ pve host — discover สดผ่าน pvecm ทุกครั้ง (pattern เดียวกับ fleet-utils
# เพราะ cluster membership เปลี่ยนได้ — ดู README.md หัวข้อ "ทำไม dynamic discovery")
#
# ใช้งาน:
#   cpu-clock static     # lscpu ของทุก node (model, min/max MHz ที่ตั้งไว้, จำนวน core)
#   cpu-clock bench      # openssl speed sha256 ของทุก node พร้อมกัน (วัดจริง ใช้เวลา ~10 วิ/node)
#   cpu-clock all         # ทั้งสองอย่าง (ค่าเริ่มต้นถ้าไม่ระบุ)
#
# ไม่ต้องติดตั้งอะไรเพิ่ม — lscpu และ openssl มีอยู่แล้วในทุก Linux host เป็นค่าเริ่มต้น

set -euo pipefail

cluster_nodes() {
  ssh -o ConnectTimeout=5 root@pve01 "pvecm nodes 2>&1" | awk '/^ *[0-9]+ / {gsub(/\(local\)/,"",$3); print $3}'
}

static_info() {
  echo "=== CPU model / clock ที่ตั้งไว้ (lscpu) — สดจากทุก node ==="
  printf "%-8s %-40s %8s %10s %10s\n" "NODE" "MODEL" "CORES" "MIN-MHz" "MAX-MHz"
  for h in $(cluster_nodes); do
    local_out=$(ssh -o ConnectTimeout=5 root@"$h" "lscpu" 2>/dev/null)
    model=$(echo "$local_out" | awk -F': +' '/^Model name:/{print $2; exit}')
    cores=$(echo "$local_out" | awk -F': +' '/^CPU\(s\):/{print $2; exit}')
    minmhz=$(echo "$local_out" | awk -F': +' '/^CPU min MHz:/{print $2; exit}')
    maxmhz=$(echo "$local_out" | awk -F': +' '/^CPU max MHz:/{print $2; exit}')
    printf "%-8s %-40s %8s %10s %10s\n" "$h" "${model:-?}" "${cores:-?}" "${minmhz:-?}" "${maxmhz:-?}"
  done
}

# openssl speed sha256 1 วินาทีสั้นๆ ต่อ node — รันพร้อมกันทุก node ผ่าน background job
# แล้วรวบรวมผล ไม่รันทีละเครื่องเพราะจะรอนานโดยไม่จำเป็น (node ละ ~10 วิ x 6 node = รอ 1 นาที
# ถ้ารันเรียง แต่รันพร้อมกันเสร็จใน ~10 วิเท่าเดิม)
bench_info() {
  echo "=== Compute throughput จริง (openssl speed sha256, 16-byte block, ล่าสุด ~10 วิ/node) ==="
  local tmpdir nodes
  tmpdir=$(mktemp -d)
  # ใช้ RETURN trap ไม่ได้ตรงๆ เพราะ tmpdir เป็น local variable ที่หลุด scope ก่อน trap ทำงาน
  # (พิสูจน์จริง 29 ส.ค. 2569 — เจอ "unbound variable" ตอนทดสอบ) ลบตรงๆ ท้าย function แทน
  nodes=$(cluster_nodes)

  for h in $nodes; do
    (ssh -o ConnectTimeout=5 root@"$h" "openssl speed -seconds 3 sha256 2>/dev/null" \
      | awk '/^sha256/{print $NF}' > "$tmpdir/$h") &
  done
  wait

  printf "%-8s %20s\n" "NODE" "sha256 16-byte (k/วิ)"
  for h in $nodes; do
    val=$(cat "$tmpdir/$h" 2>/dev/null || echo "?")
    printf "%-8s %20s\n" "$h" "$val"
  done
  rm -rf "$tmpdir"
}

main() {
  local mode="${1:-all}"
  case "$mode" in
    static) static_info ;;
    bench)  bench_info ;;
    all)    static_info; echo; bench_info ;;
    *)
      echo "ใช้งาน: cpu-clock [static|bench|all]" >&2
      exit 1
      ;;
  esac
}

main "$@"
